<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AimpTestRunner</AssemblyName>
    <RootNamespace>Aimp.TestRunner</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Platform)\$(Configuration)\</OutputPath>
    <Platforms>x86;x64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The test runner is a plugin, so the generated Rider configuration
      "AimpTestRunner (AIMP)" deploys it through deploy-plugin.ps1 and then
      launches AIMP.exe under the debugger.

      It needs its own deploy layout (the whole output folder), so the shared
      DeployToAimp target is disabled and replaced below.
    -->
    <AimpGenerateRunConfigurations>true</AimpGenerateRunConfigurations>
    <AimpDisableDefaultDeploy>true</AimpDisableDefaultDeploy>
    <AimpPluginDeployTarget>AimpTestRunnerDeployCore</AimpPluginDeployTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SDK\AIMP.SDK\AIMP.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Use only nunit.framework.dll from the package.  NUnit 4 also ships
      nunit.framework.legacy.dll (ClassicAssert compatibility), which this
      project does not use and which should not be deployed to AIMP.
    -->
    <PackageReference Include="NUnit" Version="4.0.1" GeneratePathProperty="true" ExcludeAssets="all" />
    <Reference Include="nunit.framework">
      <HintPath>$(PkgNUnit)\lib\net462\nunit.framework.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="NUnit.Engine" Version="3.16.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="nunit.engine.addins" CopyToOutputDirectory="Always" />
    <None Include="..\Resources\integrationTests\**\*"
          Link="Resources\integrationTests\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="UnitTests\Log\" />
  </ItemGroup>

  <!-- Keep /p:AimpDeployOnBuild=true working for the test runner too. -->
  <Target Name="DeployAimpTestRunnerOnBuild"
          AfterTargets="Build"
          Condition="'$(AimpDeployOnBuild)' == 'true' and Exists('$(AimpExePath)')"
          DependsOnTargets="AimpTestRunnerDeployCore" />

  <!--
    Deploys the complete test plugin into <AIMP>\Plugins\AimpTestRunner.
    Unlike a normal plugin it also needs the NUnit engine and the test
    resources, so the whole output folder is copied.

    Runs only when deploy is explicitly requested, i.e. from the generated
    "Deploy AimpTestRunner" configuration (deploy-plugin.ps1) or with
    /p:AimpDeployOnBuild=true.
  -->
  <Target Name="AimpTestRunnerDeployCore">
    <Message Importance="high" Text="Deploying AimpTestRunner to $(AimpPluginDirectory)" />

    <!-- The native shim and the managed host are not built by this project. -->
    <MSBuild Condition="!Exists('$(AimpShimDirectory)\$(AimpShimSourceName)')"
             Projects="$(AimpShimProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(AimpNativePlatform)" />
    <MSBuild Condition="!Exists('$(AimpManagedDirectory)\AIMP.Host.dll')"
             Projects="$(MSBuildThisFileDirectory)..\..\SDK\AIMP.Host\AIMP.Host.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />

    <RemoveDir Directories="$(AimpPluginDirectory)" />
    <MakeDir Directories="$(AimpPluginDirectory)" />

    <ItemGroup>
      <_AimpTestRunnerOutput Include="$(TargetDir)**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(_AimpTestRunnerOutput)"
          DestinationFiles="@(_AimpTestRunnerOutput->'$(AimpPluginDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" />

    <!-- AIMP loads <name>\<name>.dll; the managed assembly is <name>_plugin.dll. -->
    <Move SourceFiles="$(AimpPluginDirectory)\$(TargetName).dll"
          DestinationFiles="$(AimpPluginDirectory)\$(TargetName)_plugin.dll" />
    <Copy SourceFiles="$(AimpShimDirectory)\$(AimpShimSourceName)"
          DestinationFiles="$(AimpPluginDirectory)\$(AimpPluginName).dll" />
    <Copy SourceFiles="$(AimpManagedDirectory)\AIMP.Host.dll"
          DestinationFolder="$(AimpPluginDirectory)" />

    <ItemGroup>
      <_AimpTestRunnerLogs Include="$(AimpPluginDirectory)\*.log" />
    </ItemGroup>
    <Delete Files="@(_AimpTestRunnerLogs)" />
  </Target>

</Project>
