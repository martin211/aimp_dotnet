<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata minClientVersion="2.12">
    <id>AimpSDK</id>
    <version>$version$</version>
    <title>Aimp DotNet SDK</title>
    <authors>Evgeniy Bogdan</authors>
    <owners>Evgeniy Bogdan</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://github.com/martin211/aimp_dotnet</projectUrl>
    <description>Aimp DotNet allows you to create a plugin for AIMP media player on .Net. To develop plugins for AIMP x64 use AimpSDK-X64 package instead.</description>
    <tags>AIMP SDK DotNet</tags>
    <license type="expression">MIT</license>
    <repository type="git" url="https://github.com/martin211/aimp_dotnet" branch="master" />
  </metadata>
  <files>
    <file src="nuget\Tools\CopyPlugin.ps1" target="content\CopyPlugin.ps1" />
    <file src="nuget\Tools\commands.json" target="content\commands.json" />
    <file src="src\bin\managed\AIMP.SDK.dll" target="lib\net48\AIMP.SDK.dll" />
    <file src="src\bin\managed\AIMP.SDK.pdb" target="lib\net48\AIMP.SDK.pdb" />
    <file src="src\bin\managed\AIMP.Host.dll" target="tools\AIMP.Host.dll" />
    <file src="src\bin\managed\AIMP.Host.pdb" target="tools\AIMP.Host.pdb" />
    <file src="src\SDK\bin\x86\$configuration$\aimp_dotnet.dll" target="tools\aimp_dotnet.dll" />
    <file src="src\SDK\bin\x86\$configuration$\aimp_dotnet.pdb" target="tools\aimp_dotnet.pdb" />
  </files>
</package>
