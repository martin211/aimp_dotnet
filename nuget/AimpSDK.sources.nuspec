<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata minClientVersion="2.12">
    <id>AimpSDK.Sources</id>
    <version>$version$</version>
    <title>Aimp DotNet SDK sources</title>
    <authors>Evgeniy Bogdan</authors>
    <owners>Evgeniy Bogdan</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://github.com/martin211/aimp_dotnet</projectUrl>
    <description>Aimp DotNet SDK source code and native host sources.</description>
    <tags>AIMP SDK DotNet</tags>
    <license type="expression">MIT</license>
    <repository type="git" url="https://github.com/martin211/aimp_dotnet" branch="master" />
  </metadata>
  <files>
    <file src="src\SDK\AIMP.SDK\**\*.cs" exclude="**\obj\**;**\bin\**" target="src\AIMP.SDK" />
    <file src="src\SDK\AIMP.SDK\**\*.csproj" exclude="**\obj\**;**\bin\**" target="src\AIMP.SDK" />
    <file src="src\SDK\AIMP.Host\**\*.cs" exclude="**\obj\**;**\bin\**" target="src\AIMP.Host" />
    <file src="src\SDK\AIMP.Host\**\*.csproj" exclude="**\obj\**;**\bin\**" target="src\AIMP.Host" />
    <file src="src\SDK\aimp_dotnet\**\*.cpp" exclude="**\obj\**;**\bin\**" target="src\aimp_dotnet" />
    <file src="src\SDK\aimp_dotnet\**\*.rc" exclude="**\obj\**;**\bin\**" target="src\aimp_dotnet" />
    <file src="src\SDK\aimp_dotnet\**\*.def" exclude="**\obj\**;**\bin\**" target="src\aimp_dotnet" />
    <file src="src\SDK\aimp_dotnet\**\*.vcxproj" exclude="**\obj\**;**\bin\**" target="src\aimp_dotnet" />
  </files>
</package>
